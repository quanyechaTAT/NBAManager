# Copy this file to .env and replace placeholders.
# Load .env into the shell before starting Java or Python; see README.md.

# MySQL: Java defaults to localhost:3306/nba_manager.
DB_USERNAME=root
DB_PASSWORD=replace-with-your-database-password
# Python services use these defaults. For a different Java database endpoint,
# also set SPRING_DATASOURCE_URL to a complete JDBC URL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nba_manager

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT: generate your own random value of at least 32 bytes.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-secret-generated-for-your-installation

# DeepSeek: required for AI answers, replay explanations and LLM translation.
# Leave the API key empty if you only want to use the data/community features.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RAG_LLM_MODEL=deepseek-v4-flash

# Java starts local RAG/Copilot subprocesses when needed.
RAG_SERVER_URL=http://127.0.0.1:18999
COPILOT_BASE_URL=http://127.0.0.1:18998/api/nba-copilot
# Used when starting the Python services manually.
RAG_PORT=18999
NBA_COPILOT_PORT=18998
NBA_MANAGER_API=http://127.0.0.1:8080

# Optional absolute Python path for data/translation subprocesses.
# AI service launchers look for scripts/venv312 separately.
PYTHON_EXECUTABLE=

# Optional proxy for NBA data collection.
# Leave both blank for direct access. HTTP(S) URL in NBA_PROXY_HOST is also supported.
# Only these settings control data providers; OS/HTTP_PROXY settings are not inherited.
# If the configured proxy fails, GET requests retry directly once (TLS stays verified).
NBA_PROXY_HOST=
NBA_PROXY_PORT=

# Optional credentials for news-maintenance / performance-measurement scripts.
# These variables do not create application accounts.
# Register an account and assign its role first, as described in README.md.
ADMIN_USER=admin
ADMIN_PASS=

# RAG search and evidence thresholds
RAG_SEARCH_ENABLED=true
RAG_SEARCH_PROVIDERS=espn_scoreboard,espn_news,google_news_rss
RAG_SEARCH_TIMEOUT_SECONDS=8
RAG_SEARCH_TOP_K=5
RAG_SEARCH_CACHE_TTL_SECONDS=600
RAG_ALLOW_GENERAL_WEB_SEARCH=false
RAG_SEARXNG_BASE_URL=
RAG_BAIDU_MIN_INTERVAL_SECONDS=15
RAG_BAIDU_CIRCUIT_BREAKER_SECONDS=600
RAG_MAX_VECTOR_DISTANCE=0.68
RAG_MIN_RERANK_SCORE=0
RAG_FORCE_WEB_SEARCH=false
# Constrained query planning and optional HyDE; auxiliary requests have their own budget.
RAG_QUERY_PLANNER_MODE=auto
RAG_QUERY_PLANNER_TIMEOUT_SECONDS=5
RAG_MULTI_QUERY_LIMIT=3
RAG_HYDE_ENABLED=true
RAG_HYDE_TIMEOUT_SECONDS=5
RAG_AUTO_BUILD_INDEX=true
# Bounded query caches; set a capacity or TTL to 0 to bypass that cache.
RAG_EMBEDDING_CACHE_MAX_ENTRIES=512
RAG_EMBEDDING_CACHE_TTL_SECONDS=3600
RAG_RETRIEVAL_CACHE_MAX_ENTRIES=256
RAG_RETRIEVAL_CACHE_TTL_SECONDS=60
# Cache epoch tags, not Hugging Face revision pins. Bump when replacing local weights.
RAG_EMBEDDING_REVISION=default
RAG_RERANKER_REVISION=default
# Hot public reads: per-cache concurrent distinct loads and maximum follower wait.
CACHE_MAX_CONCURRENT_LOADS=128
CACHE_LOAD_WAIT_MILLIS=10000
# Shared budget for manual, scheduled and login-triggered sync jobs (hard max 8 workers).
SYNC_EXECUTOR_CORE_SIZE=2
SYNC_EXECUTOR_MAX_SIZE=4
SYNC_EXECUTOR_QUEUE_CAPACITY=16
RAG_LLM_TIMEOUT_SECONDS=300

# CPU is the default; enable auto detection only after installing suitable torch.
RAG_AUTO_DETECT_DEVICE=false

# Streaming / model timeouts
RAG_CONNECT_TIMEOUT_MS=10000
RAG_READ_TIMEOUT_MS=600000
RAG_ASYNC_TIMEOUT_MS=600000
VITE_RAG_STREAM_IDLE_TIMEOUT_MS=300000

# For deployment, explicitly restrict allowed origins to your frontend domain.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# WS_ALLOWED_ORIGINS=https://your-frontend.example
# TRUSTED_PROXY_IPS=127.0.0.1
