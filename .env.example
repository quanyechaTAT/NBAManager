# 数据库配置
DB_USERNAME=root
DB_PASSWORD=your_password_here

# MIMO 翻译 API（用于球员名中文翻译）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# NBA API 代理（可选，用于访问 stats.nba.com）
NBA_PROXY_HOST=
NBA_PROXY_PORT=

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 初始管理员账号（首次启动时创建）
ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here

# 初始普通用户账号
USER_USER=user
USER_PASS=your_user_password_here

# ═══ RAG 联网搜索配置 ═══
RAG_SEARCH_ENABLED=true
RAG_SEARCH_PROVIDERS=espn_scoreboard,espn_news,google_news_rss,baidusearch
RAG_SEARCH_TIMEOUT_SECONDS=8
RAG_SEARCH_TOP_K=5
RAG_SEARCH_CACHE_TTL_SECONDS=600
RAG_BAIDU_MIN_INTERVAL_SECONDS=15
RAG_BAIDU_CIRCUIT_BREAKER_SECONDS=600
RAG_SEARXNG_BASE_URL=
RAG_ALLOW_GENERAL_WEB_SEARCH=false
RAG_MAX_VECTOR_DISTANCE=0.68
RAG_MIN_RERANK_SCORE=0
RAG_FORCE_WEB_SEARCH=false
